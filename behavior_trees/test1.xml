<root main_tree_to_execute="MainTree">
    <BehaviorTree ID="MainTree">
        <RecoveryNode number_of_retries="3" name="Navigeren">

            <!--Kind 1: Normaal rijden-->
            <PipelineSequence name="PlannenEnVolgen">
                <RateController hz="0.5">
                    <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
                </RateController>
                <FollowPath path="{path}" controller_id="FollowPath"/>
            </PipelineSequence>

            <!--Herstel, alleen als kind 1 faalt -->
            <Sequence name="Herstel">
                <ClearEntireCostmap name="WisLokaal"
                    service_name="local_costmap/clear_entirely_local_costmap"/>
                <ClearEntireCostmap name="WisGlobaal"
                    service_name="global_costmap/clear_entirely_global_costmap"/>
                <Wait wait_duration="2.0"/>
                <BackUp backup_dist="0.30" backup_speed="0.05"/>
            </Sequence>
        
        </RecoveryNode>
    </BehaviorTree>
</root>