<?xml version="1.0"?>
<!-- Romp + hoofd van een paspop (WalkingPeopleNode). Zichtbaar deel ruim boven het lidarvlak (~18 cm),
     zodat de lidar alleen de benen ziet. Collision is alleen een smal voetje (r 3 cm) tussen de
     benen in, om op de vloer te staan; zwaartepunt laag zodat hij niet omvalt. collide_bitmask
     0x04 (benen 0x02): romp en benen raken elkaar niet, de vloer en de robot wel. -->
<sdf version="1.9">
  <model name="paspop_romp">
    <link name="link">
      <inertial><pose>0 0 0.05 0 0 0</pose><mass>10</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
      <collision name="voet">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry><cylinder><radius>0.03</radius><length>0.1</length></cylinder></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction><contact><collide_bitmask>0x04</collide_bitmask></contact></surface>
      </collision>
      <visual name="romp">
        <pose>0 0 1.15 0 0 0</pose>
        <geometry><cylinder><radius>0.18</radius><length>0.65</length></cylinder></geometry>
        <material><diffuse>0.85 0.85 0.8 1</diffuse><ambient>0.85 0.85 0.8 1</ambient></material>
      </visual>
      <visual name="heup">
        <pose>0 0 0.84 0 0 0</pose>
        <geometry><box><size>0.16 0.32 0.1</size></box></geometry>
        <material><diffuse>0.15 0.2 0.35 1</diffuse><ambient>0.15 0.2 0.35 1</ambient></material>
      </visual>
      <visual name="hoofd">
        <pose>0 0 1.62 0 0 0</pose>
        <geometry><sphere><radius>0.11</radius></sphere></geometry>
        <material><diffuse>0.9 0.75 0.6 1</diffuse><ambient>0.9 0.75 0.6 1</ambient></material>
      </visual>
    </link>
    <plugin filename="ignition-gazebo-velocity-control-system" name="ignition::gazebo::systems::VelocityControl"/>
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
